{
  "name": "helmsman",
  "version": "0.0.0",
  "private": true,
  "description": "Helmsman — a fully agentic SDLC platform (engine-agnostic: Amp + Copilot).",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm build && pnpm --filter @helmsman/core-orchestrator --filter @helmsman/auth-vault --filter @helmsman/mcp-gateway --filter @helmsman/workflows run test",
    "lint": "pnpm -r run lint",
    "demo:fixbug": "pnpm --filter @helmsman/core-orchestrator run demo"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.6.0"
  }
}
